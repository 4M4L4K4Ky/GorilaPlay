#!/usr/bin/env bash
# GorilaPlay - descargador de playlists (YouTube, Spotify y más)
# Interfaz KDE: kdialog + konsole. Motor: yt-dlp.
set -u

VERSION="1.1"
YTDLP="${YTDLP:-$(command -v yt-dlp || echo "$HOME/.local/bin/yt-dlp")}"
AQUI="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DATOS="$HOME/.local/share/gorilaplay"
SPOTIFY="$DATOS/spotify_descargar.py"
[ -f "$SPOTIFY" ] || SPOTIFY="$AQUI/spotify_descargar.py"
CARATULAS="$DATOS/caratulas.py"
[ -f "$CARATULAS" ] || CARATULAS="$AQUI/caratulas.py"
ESTADO="$HOME/.local/state/gorilaplay"
ARCHIVO="$ESTADO/descargados.txt"
TITULO="GorilaPlay"
mkdir -p "$ESTADO"

# 0. Qué hacemos
ACCION=$(kdialog --title "$TITULO" --menu "¿Qué quieres hacer?" \
    descargar "Descargar vídeo o playlist (YouTube, Spotify...)" \
    caratulas "Poner carátula a las canciones de una carpeta") || exit 0

# ---------------------------------------------------------------- carátulas
if [ "$ACCION" = caratulas ]; then
    if [ ! -f "$CARATULAS" ]; then
        kdialog --title "$TITULO" --error "No encuentro caratulas.py."
        exit 1
    fi
    if ! command -v python3 >/dev/null || ! python3 -c 'import mutagen' 2>/dev/null; then
        kdialog --title "$TITULO" --error "Falta mutagen (Python).

Instálalo con:  sudo dnf install python3-mutagen
o bien:         pip install --user mutagen"
        exit 1
    fi

    INICIO="$HOME/Música"
    [ -d "$INICIO" ] || INICIO="$HOME"
    DESTINO=$(kdialog --title "$TITULO - carpeta de música" \
        --getexistingdirectory "$INICIO") || exit 0

    MODO=$(kdialog --title "$TITULO" --radiolist \
        "¿Qué canciones quieres tocar?" \
        faltantes "Solo las que no tienen carátula" on \
        todas     "Todas, reemplazando la carátula actual" off) || exit 0
    MODIFICADOR=""
    [ "$MODO" = todas ] && MODIFICADOR="--reemplazar"

    LOG="$ESTADO/caratulas-$(date +%Y%m%d-%H%M%S).log"
    RUNNER="$(mktemp "$ESTADO/runner-XXXXXX.sh")"
    {
        echo '#!/usr/bin/env bash'
        printf 'echo "GorilaPlay %s - carátulas"\necho\n' "$VERSION"
        printf 'echo "Carpeta: %s"\necho\n' "$DESTINO"
        printf 'python3 %q %q %s 2>&1 | tee %q\n' \
            "$CARATULAS" "$DESTINO" "$MODIFICADOR" "$LOG"
        echo 'rc=${PIPESTATUS[0]}'
    } > "$RUNNER"
    {
        echo 'echo'
        echo 'if [ "$rc" -eq 0 ]; then'
        printf '    notify-send -i folder-download %q "Carátulas puestas"\n' "$TITULO"
        echo '    sleep 2'
        echo 'else'
        printf '    echo "Algunas canciones se han quedado sin carátula. Log: %s"\n' "$LOG"
        printf '    notify-send -i dialog-information %q "Carátulas terminadas con avisos"\n' "$TITULO"
        echo '    read -r -p "Pulsa Enter para cerrar..." _'
        echo 'fi'
        printf 'rm -f %q\n' "$RUNNER"
    } >> "$RUNNER"
    chmod +x "$RUNNER"
    if command -v konsole >/dev/null; then
        konsole --title "$TITULO" -e bash "$RUNNER"
    else
        x-terminal-emulator -e bash "$RUNNER" 2>/dev/null || bash "$RUNNER"
    fi
    exit 0
fi

# ---------------------------------------------------------------- descarga
if [ ! -x "$YTDLP" ]; then
    kdialog --title "$TITULO" --error "No encuentro yt-dlp.
Instálalo con:  pipx install yt-dlp"
    exit 1
fi

# 1. URL
URL=$(kdialog --title "$TITULO" \
    --inputbox "Pega la dirección del vídeo o de la playlist (YouTube o Spotify):" \
    "https://www.youtube.com/playlist?list=") || exit 0
URL="${URL// /}"
[ -z "$URL" ] && exit 0
case "$URL" in
    http*) ;;
    *) kdialog --title "$TITULO" --error "Eso no parece una dirección web."; exit 1 ;;
esac

case "$URL" in
    *open.spotify.com*) TIPO=spotify ;;
    *)                  TIPO=yt ;;
esac

# 2. Formato
if [ "$TIPO" = spotify ]; then
    OPCION=$(kdialog --title "$TITULO" --radiolist \
        "Spotify: solo audio (la música se baja de YouTube)" \
        mp3-320 "Audio MP3 320 kbps" on \
        mp3-192 "Audio MP3 192 kbps" off) || exit 0
else
    OPCION=$(kdialog --title "$TITULO" --radiolist "¿Qué quieres descargar?" \
        mp3-320 "Audio MP3 320 kbps" on \
        mp3-192 "Audio MP3 192 kbps" off \
        m4a     "Audio original (m4a, sin recodificar)" off \
        video   "Vídeo (mejor calidad hasta 1080p)" off) || exit 0
fi
[ -z "$OPCION" ] && exit 0

# 3. Carpeta destino
INICIO="$HOME/Música"
[ -d "$INICIO" ] || INICIO="$HOME"
DESTINO=$(kdialog --title "$TITULO" --getexistingdirectory "$INICIO") || exit 0
[ -z "$DESTINO" ] && DESTINO="$INICIO"

LOG="$ESTADO/$(date +%Y%m%d-%H%M%S).log"
RUNNER="$(mktemp "$ESTADO/runner-XXXXXX.sh")"

if [ "$TIPO" = spotify ]; then
    BITRATE="${OPCION#mp3-}"
    {
        echo '#!/usr/bin/env bash'
        printf 'echo "GorilaPlay %s - Spotify"\necho\n' "$VERSION"
        printf 'echo "Origen: %s"\necho\n' "$URL"
        printf 'python3 %q %q %q %q 2>&1 | tee %q\n' \
            "$SPOTIFY" "$URL" "$DESTINO" "$BITRATE" "$LOG"
        echo 'rc=${PIPESTATUS[0]}'
    } > "$RUNNER"
else
    PLANTILLA="$DESTINO/%(playlist_title,playlist_id|Sueltas)s/%(artist,creator,uploader,channel)s - %(title)s.%(ext)s"
    case "$OPCION" in
        mp3-320) ARGS=(-x --audio-format mp3 --audio-quality 320K --embed-metadata --embed-thumbnail) ;;
        mp3-192) ARGS=(-x --audio-format mp3 --audio-quality 192K --embed-metadata --embed-thumbnail) ;;
        m4a)     ARGS=(-f "bestaudio[ext=m4a]/bestaudio" --embed-metadata --embed-thumbnail) ;;
        video)   ARGS=(-f "bv*[height<=1080]+ba/b[height<=1080]" --merge-output-format mp4 --embed-metadata) ;;
        *) exit 0 ;;
    esac
    {
        echo '#!/usr/bin/env bash'
        printf 'cd %q || exit 1\n' "$DESTINO"
        printf 'echo "GorilaPlay %s"\necho\n' "$VERSION"
        printf 'echo "Origen: %s"\necho\n' "$URL"
        printf '%q ' "$YTDLP" "${ARGS[@]}"
        printf '%q ' --output "$PLANTILLA" --download-archive "$ARCHIVO" \
            --no-overwrites --ignore-errors --newline \
            --retries 5 --fragment-retries 5 --sleep-requests 1
        printf '%q ' "$URL"
        printf '2>&1 | tee %q\n' "$LOG"
        echo 'rc=${PIPESTATUS[0]}'
    } > "$RUNNER"
fi

{
    echo 'echo'
    echo 'if [ "$rc" -eq 0 ]; then'
    printf '    echo "Terminado. Archivos en: %s"\n' "$DESTINO"
    printf '    notify-send -i folder-download %q "Descarga terminada"\n' "$TITULO"
    echo '    sleep 3'
    echo 'else'
    printf '    echo "Ha habido errores (código $rc). Log: %s"\n' "$LOG"
    printf '    notify-send -i dialog-error %q "La descarga terminó con errores"\n' "$TITULO"
    echo '    read -r -p "Pulsa Enter para cerrar..." _'
    echo 'fi'
    printf 'rm -f %q\n' "$RUNNER"
} >> "$RUNNER"

chmod +x "$RUNNER"

if command -v konsole >/dev/null; then
    konsole --title "$TITULO" -e bash "$RUNNER"
else
    x-terminal-emulator -e bash "$RUNNER" 2>/dev/null || bash "$RUNNER"
fi
exit 0
